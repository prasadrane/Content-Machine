# Content Machine environment template.
# Copy to .env (git-ignored) and fill in your own values:  cp .env.example .env
# Never commit a filled .env - it carries live credentials.

# --- LLM relay (required for local generation) -------------------------------
# Content Machine speaks the Anthropic Messages protocol. Point these at any
# Anthropic-compatible relay/gateway you operate, or leave the official
# Anthropic defaults by using your own API key with https://api.anthropic.com
ANTHROPIC_BASE_URL=http://your-relay-host:port/apps/anthropic
ANTHROPIC_AUTH_TOKEN=your-bearer-token

# --- Gemini (optional locally, required for the public demo) -----------------
# Native Gemini provider (content_machine/router/gemini.py). When DEMO_MODE=1
# and this key is set, all routes switch to gemini-2.5-flash.
GEMINI_API_KEY=

# --- Public demo switches (Vercel sets these; leave unset locally) ----------
# DEMO_MODE=1 forces gemini-only routes, 1-iteration council, and the UI banner.
DEMO_MODE=
# Storage root override. Default: ~/.content_machine ; Vercel uses /tmp/cm.
CONTENT_MACHINE_HOME=

# --- Optional connectors ------------------------------------------------------
# GitHub connector rate limits: personal access token (public_repo scope ok).
GITHUB_PAT=
# LinkedIn Voyager session cookie for authenticated profile/feed sync.
# Browser-session sync additionally needs: playwright install chromium
LINKEDIN_LI_AT=

# --- Dev servers --------------------------------------------------------------
# UI dev server port (vite) and the backend port its /api proxy targets.
# PORT=5174
# BACKEND_PORT=8080
